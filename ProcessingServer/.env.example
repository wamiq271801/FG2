# ProcessingServer environment.
# Copy to `.env` for local dev. Never commit real credentials.

PORT=3002

# Cron trigger protection: only requests carrying this shared secret run a cycle.
PROCESSOR_CRON_SECRET="replace-with-a-long-random-string"

# TiDB (read raw events + manage checkpoint/lock)
TIDB_HOST="gateway01.us-east-1.prod.aws.tidbcloud.com"
TIDB_PORT=4000
TIDB_USER="prefix.root"
TIDB_PASSWORD="replace-with-tidb-password"
TIDB_DATABASE="fusion_tracking"

# Supabase (publish ready circulation results — service-role, privileged)
SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# Bounded batch size for one processing run (keeps memory bounded)
PROCESSOR_BATCH_SIZE=5000
