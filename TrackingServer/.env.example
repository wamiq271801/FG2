# TrackingServer environment.
# Copy to `.env` for local dev. Never commit real credentials.

PORT=3001

# TiDB connection (server-side only — never shipped to the browser)
TIDB_HOST="gateway01.us-east-1.prod.aws.tidbcloud.com"
TIDB_PORT=4000
TIDB_USER="prefix.root"
TIDB_PASSWORD="replace-with-tidb-password"
TIDB_DATABASE="fusion_tracking"

# Shared HMAC secret to authenticate the storefront's batch POST
TRACKING_INGEST_SECRET="replace-with-a-long-random-string"
