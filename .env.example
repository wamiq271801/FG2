# ============================================================
# Fusion Gadgets — storefront environment.
# Copy to `.env` (or rely on the hardcoded defaults in lib/supabase/config.ts).
#
# TEST PROJECT KEYS — disposable. The same values are hardcoded in
# lib/supabase/config.ts as fallbacks so the app works even if .env is
# overwritten by the sandbox boot script. `.env.local` also carries these
# as a second backup.
#
# Browser-safe vars use the NEXT_PUBLIC_ prefix. The service-role key is
# NEVER in this file — it lives only in worker/ and ProcessingServer/ source.
# ============================================================

# --- Storefront (browser + server, anon key only) ---
NEXT_PUBLIC_SUPABASE_URL=https://onyzjnitnekjhdexecdm.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im9ueXpqbml0bmVramhkZXhlY2RtIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODcwMzc2NTUsImV4cCI6MjEwMjYxMzY1NX0.GqXaLdE4txXx5cooRRc4TS01OfjVzP4Sq8MxfpGY-HA

# --- Public site URL (sitemap / robots / metadata base) ---
NEXT_PUBLIC_SITE_URL=https://fusiongadgets.shop

# Cloudflare Worker URL (dev: http://localhost:8787, prod: https://worker.yourdomain.workers.dev)
NEXT_PUBLIC_WORKER_URL=http://localhost:8787

# TrackingServer URL (dev: http://localhost:3001, prod: https://tracking.yourdomain.com)
NEXT_PUBLIC_TRACKING_URL=http://localhost:3001

# Cloudflare Turnstile — PUBLIC site key (safe for the browser). The matching
# secret key (TURNSTILE_SECRET_KEY) lives ONLY on the Worker and must NEVER be
# exposed via NEXT_PUBLIC_. Default here is Cloudflare's documented test site
# key (always passes) so local dev works without real keys.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEWdqg5FqcBGvOLw

# --- Storefront cache invalidation (Phase 2, server-only) ---
# Shared secret between the admin (STOREFRONT_REVALIDATE_SECRET) and this
# storefront's POST /api/revalidate endpoint. NEVER expose with
# NEXT_PUBLIC_*, never in client code, HTML, URLs or logs.
REVALIDATE_SECRET=change-me-in-production
